{
  "name": "pokeengmon",
  "version": "1.71.0",
  "private": true,
  "description": "Pokémon-themed English learning PWA (static + Supabase)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MARCOTT402/PokeEngmon.git"
  },
  "scripts": {
    "sync-version": "python tools/sync_app_version.py",
    "preview:iphone": "node tools/preview-iphone.mjs",
    "preview:iphone15": "node tools/preview-iphone.mjs --device iphone-15",
    "release": "semantic-release",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\"",
    "test:e2e": "node tools/responsive/run-all.mjs",
    "prelint": "node tools/audit/gen-eslint-globals.mjs",
    "lint": "eslint js tests --max-warnings 0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "semantic-release": "^24.2.3",
    "typescript": "5.9"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "python tools/sync_app_version.py"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md",
            "js/app.js",
            "sw.js",
            "index.html",
            "prd.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
